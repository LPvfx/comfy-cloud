# Copy to .env (git-ignored). All optional.

# Defaults for `comfy-cloud up`
COMFY_GPU=RTX_4090            # RTX_5090, L40S, RTX_6000Ada, H100_SXM ...
COMFY_MAX_PRICE=0.80          # $/hour cap
COMFY_DISK=150                # GB; LTX-2.5 full needs ~100 for models alone
COMFY_MODELS=smoke            # default model sets, e.g. ltx25
# COMFY_IMAGE=pytorch/pytorch:2.14.1-cuda13.0-cudnn9-devel
# COMFY_MIN_CUDA=13.0          # drop to 12.8 for more (older-driver) hosts + a cuda12 image

# Hugging Face (needed for gated models such as Lightricks LTX)
HF_TOKEN=

# Cloudflare R2 for your LoRAs/inputs between sessions (remote/r2.sh)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=comfy
